{
  "manifest_version": 3,
  "name": "Grounded / 已发生",
  "description": "少一点想象，多一点已发生。A calm reality log for what already happened.",
  "version": "0.1.0",
  "action": {
    "default_title": "已发生",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "commands": {
    "quick-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open Grounded quick capture"
    }
  }
}
